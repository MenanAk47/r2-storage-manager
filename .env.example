# ==============================================================================
# Cloudflare R2 Storage Manager - Environment Configuration Template
# ==============================================================================
# Quick Start:
# 1. Copy this file to '.env' (or use Docker Compose).
# 2. Fill in the 4 Cloudflare R2 credentials below.
# 3. Run 'npm start' or 'docker compose up -d'
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Cloudflare R2 Credentials (Required)
# ------------------------------------------------------------------------------
# 1. Cloudflare Account ID: Found in your Cloudflare Dashboard URL or Overview tab.
#    Example: e6f1c7967cfad2d9d2b118d4a733daa7
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# 2. R2 API Token Access Key ID & Secret Access Key:
#    Created in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> "Create API Token"
#    Permissions: "Object Read & Write" (or Admin Read & Write).
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# 3. R2 Bucket Name: The exact name of your bucket created in Cloudflare R2.
R2_BUCKET_NAME=your_r2_bucket_name

# ------------------------------------------------------------------------------
# Optional Settings
# ------------------------------------------------------------------------------
# 4. Jurisdiction: Specify 'eu' or 'fedramp' if your bucket has a jurisdiction constraint.
#    Leave blank for standard/global default buckets.
R2_JURISDICTION=

# 5. Public CDN URL / Custom Domain:
#    If your bucket has a custom domain or pub-*.r2.dev enabled, provide it here.
#    Example: https://cdn.yourdomain.com OR https://pub-7ca9b12ac95f403cad691ed4852e8280.r2.dev
#    Leave blank if your bucket is private (files will stream securely through the backend).
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Master Password required to log into your file manager dashboard.
# (Default is 'admin' if left blank)
DASHBOARD_PASSWORD=change_this_to_a_strong_password

# Optional: Secret string used to sign session cookies.
# If left blank, a secure random key is automatically generated on startup.
SESSION_SECRET=
